def _generate_sample_code(
    sample_id: int,
) -> str:
    """
    Generate the traditional AL-XXXX sample code.

    Example:

        1   -> AL-0001
        25  -> AL-0025
        200 -> AL-0200

    Existing sample IDs therefore retain their original
    sample-code convention.
    """

    return f"AL-{sample_id:04d}"


