def get_reference_samples(
    experiment_id: int = 1,
    exclude_sample_id: Optional[int] = None,
):
    """
    Return labeled samples that can be used as ML references.

    CRITICAL EXPERIMENT ISOLATION:

    Only samples from the selected experiment are returned.

    Therefore:

        EXP-001 -> references only EXP-001

        EXP-002 -> references only EXP-002

    This prevents data leakage between experiments.
    """

    ensure_experiment_exists(
        experiment_id
    )

    conn = get_connection()

    try:

        if exclude_sample_id is None:

            rows = conn.execute(
                """
                SELECT *
                FROM samples
                WHERE experiment_id = ?
                  AND position_id IS NOT NULL
                  AND features IS NOT NULL
                ORDER BY id
                """,
                (
                    experiment_id,
                ),
            ).fetchall()

        else:

            rows = conn.execute(
                """
                SELECT *
                FROM samples
                WHERE experiment_id = ?
                  AND id != ?
                  AND position_id IS NOT NULL
                  AND features IS NOT NULL
                ORDER BY id
                """,
                (
                    experiment_id,
                    exclude_sample_id,
                ),
            ).fetchall()

        results = []

        for row in rows:

            item = dict(row)

            if item.get("features"):

                try:

                    item["features"] = json.loads(
                        item["features"]
                    )

                except json.JSONDecodeError:
                    pass

            results.append(item)

        return results

    finally:
        conn.close()


# ============================================================
# UPDATE SAMPLE
# ============================================================

def update_sample(
    sample_id: int,
    *,
    position_id: Optional[int],
    target_presence: str,
    distance_cm: Optional[float],
    remarks: Optional[str],
):
    """
    Update sample metadata.

    This function preserves the original dataset API.

    Prediction fields are reset because changing the ground
    truth metadata invalidates the previous evaluation.
    """

    connection = get_connection()

    try:

        # ----------------------------------------------------
        # Find sample.
        # ----------------------------------------------------

        existing = connection.execute(
            """
            SELECT
                id,
                experiment_id
            FROM samples
            WHERE id = ?
            """,
            (
                sample_id,
            ),
        ).fetchone()

        if existing is None:
            return None

        experiment_id = existing[
            "experiment_id"
        ]

        # ----------------------------------------------------
        # Validate position.
        # ----------------------------------------------------

        if position_id is not None:

            position = connection.execute(
                """
                SELECT id
                FROM positions
                WHERE id = ?
                  AND experiment_id = ?
                """,
                (
                    position_id,
                    experiment_id,
                ),
            ).fetchone()

            if position is None:

                raise ValueError(
                    "Selected position does not belong "
                    "to the sample's experiment."
                )

        # ----------------------------------------------------
        # Update.
        # ----------------------------------------------------

        connection.execute(
            """
            UPDATE samples
            SET
                position_id = ?,
                target_presence = ?,
                distance_cm = ?,
                remarks = ?,

                predicted_position_id = NULL,

                prediction_confidence = NULL,

                prediction_evaluation = NULL,

                prediction_timestamp = NULL

            WHERE id = ?
            """,
            (
                position_id,
                target_presence,
                distance_cm,
                remarks,
                sample_id,
            ),
        )

        connection.commit()

        return get_sample(
            sample_id,
            experiment_id=experiment_id,
        )

    finally:
        connection.close()


# ============================================================
# DELETE SAMPLE
# ============================================================

def delete_sample(
    sample_id: int,
):
    """
    Delete a sample record.

    The associated WAV filename and experiment ID are returned
    to the API layer so the API can remove the corresponding
    physical recording if required.
    """

    connection = get_connection()

    try:

        row = connection.execute(
            """
            SELECT
                id,
                experiment_id,
                recording_filename
            FROM samples
            WHERE id = ?
            """,
            (
                sample_id,
            ),
        ).fetchone()

        if row is None:
            return None

        experiment_id = row[
            "experiment_id"
        ]

        sample = get_sample(
            sample_id,
            experiment_id=experiment_id,
        )

        connection.execute(
            """
            DELETE FROM samples
            WHERE id = ?
            """,
            (
                sample_id,
            ),
        )

        connection.commit()

        return {
            "sample": sample,

            "recording_filename":
                row["recording_filename"],

            "experiment_id":
                experiment_id,
        }

    finally:
        connection.close()


