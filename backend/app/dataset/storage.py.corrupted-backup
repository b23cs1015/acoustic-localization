def get_experiment(
    experiment_id: int,
):
    """
    Get an experiment by database ID.
    """

    conn = get_connection()

    try:

        row = conn.execute(
            """
            SELECT
                id,
                name,
                description,
                created_at
            FROM experiments
            WHERE id = ?
            """,
            (
                experiment_id,
            ),
        ).fetchone()

        if row is None:
            return None

        return dict(row)

    finally:
        conn.close()


def ensure_experiment_exists(
    experiment_id: int,
):
    """
    Ensure that an experiment exists.

    Raises:
        ValueError
    """

    experiment = get_experiment(
        experiment_id
    )

    if experiment is None:

        raise ValueError(
            f"Experiment {experiment_id} does not exist."
        )

    return experiment


