# ============================================================
# MIGRATION OF EXISTING RECORDINGS
# ============================================================

def migrate_existing_recordings_to_experiment(
    experiment_id: int = 1,
):
    """
    Copy legacy recordings into the selected experiment.

    IMPORTANT:

    This function COPIES files.

    It does NOT delete the original files.

    Therefore it is safe to run multiple times.

    Example:

        backend/data/dataset/recordings/
            AL-0006.wav
            AL-0007.wav
            ...

    becomes:

        backend/data/dataset/experiments/EXP-001/recordings/
            AL-0006.wav
            AL-0007.wav
            ...
    """

    ensure_experiment_exists(
        experiment_id
    )

    source_dir = (
        LEGACY_RECORDINGS_DIR
    )

    destination_dir = (
        get_experiment_recordings_dir(
            experiment_id
        )
    )

    if not source_dir.exists():

        return {
            "source": str(
                source_dir
            ),

            "destination": str(
                destination_dir
            ),

            "copied": 0,

            "skipped": 0,
        }

    copied = 0
    skipped = 0

    for source_file in source_dir.glob(
        "*.wav"
    ):

        destination_file = (
            destination_dir
            / source_file.name
        )

        # ----------------------------------------------------
        # Do not overwrite an existing file.
        # ----------------------------------------------------

        if destination_file.exists():

            skipped += 1

            continue

        destination_file.write_bytes(
            source_file.read_bytes()
        )

        copied += 1

    return {
        "source": str(
            source_dir
        ),

        "destination": str(
            destination_dir
        ),

        "copied": copied,

        "skipped": skipped,
    }


# ============================================================
# DATASET SUMMARY
# ============================================================

def get_summary(
    experiment_id: Optional[int] = None,
):
    """
    Return dataset summary.

    If experiment_id is provided:

        statistics are restricted to that experiment.

    If experiment_id is omitted:

        statistics include all experiments.

    This preserves the original API behaviour while allowing
    experiment-specific research analysis.
    """

    connection = get_connection()

    try:

        # ====================================================
        # BASIC FILTER
        # ====================================================

        if experiment_id is None:

            where_clause = ""

            params = ()

        else:

            where_clause = """
                WHERE experiment_id = ?
            """

            params = (
                experiment_id,
            )

        # ====================================================
        # TOTAL SAMPLES
        # ====================================================

        total_samples = connection.execute(
            f"""
            SELECT COUNT(*) AS count
            FROM samples
            {where_clause}
            """,
            params,
        ).fetchone()["count"]

        # ====================================================
        # LABELED SAMPLES
        # ====================================================

        if experiment_id is None:

            labeled_samples = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE position_id IS NOT NULL
                """
            ).fetchone()["count"]

        else:

            labeled_samples = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE experiment_id = ?
                  AND position_id IS NOT NULL
                """,
                (
                    experiment_id,
                ),
            ).fetchone()["count"]

        # ====================================================
        # EVALUABLE PREDICTIONS
        # ====================================================

        if experiment_id is None:

            evaluable_predictions = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE prediction_evaluation IN (
                    'correct',
                    'incorrect'
                )
                """
            ).fetchone()["count"]

        else:

            evaluable_predictions = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE experiment_id = ?
                  AND prediction_evaluation IN (
                      'correct',
                      'incorrect'
                  )
                """,
                (
                    experiment_id,
                ),
            ).fetchone()["count"]

        # ====================================================
        # CORRECT
        # ====================================================

        if experiment_id is None:

            correct_predictions = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE prediction_evaluation = 'correct'
                """
            ).fetchone()["count"]

        else:

            correct_predictions = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE experiment_id = ?
                  AND prediction_evaluation = 'correct'
                """,
                (
                    experiment_id,
                ),
            ).fetchone()["count"]

        # ====================================================
        # INCORRECT
        # ====================================================

        if experiment_id is None:

            incorrect_predictions = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE prediction_evaluation = 'incorrect'
                """
            ).fetchone()["count"]

        else:

            incorrect_predictions = connection.execute(
                """
                SELECT COUNT(*) AS count
                FROM samples
                WHERE experiment_id = ?
                  AND prediction_evaluation = 'incorrect'
                """,
                (
                    experiment_id,
                ),
            ).fetchone()["count"]

        # ====================================================
        # ACCURACY
        # ====================================================

        accuracy = None

        if evaluable_predictions > 0:

            accuracy = (
                correct_predictions
                / evaluable_predictions
            )

        # ====================================================
        # POSITION DISTRIBUTION
        # ====================================================

        if experiment_id is None:

            position_rows = connection.execute(
                """
                SELECT
                    COALESCE(
                        p.name,
                        'Unlabelled'
                    ) AS name,

                    COUNT(*) AS count

                FROM samples s

                LEFT JOIN positions p
                    ON s.position_id = p.id

                GROUP BY
                    COALESCE(
                        p.name,
                        'Unlabelled'
                    )

                ORDER BY count DESC
                """
            ).fetchall()

        else:

            position_rows = connection.execute(
                """
                SELECT
                    COALESCE(
                        p.name,
                        'Unlabelled'
                    ) AS name,

                    COUNT(*) AS count

                FROM samples s

                LEFT JOIN positions p
                    ON s.position_id = p.id

                WHERE s.experiment_id = ?

                GROUP BY
                    COALESCE(
                        p.name,
                        'Unlabelled'
                    )

                ORDER BY count DESC
                """,
                (
                    experiment_id,
                ),
            ).fetchall()

        positions = {
            row["name"]: row["count"]
            for row in position_rows
        }

        # ====================================================
        # TARGET PRESENCE
        # ====================================================

        if experiment_id is None:

            target_rows = connection.execute(
                """
                SELECT
                    target_presence,
                    COUNT(*) AS count

                FROM samples

                GROUP BY target_presence
                """
            ).fetchall()

        else:

            target_rows = connection.execute(
                """
                SELECT
                    target_presence,
                    COUNT(*) AS count

                FROM samples

                WHERE experiment_id = ?

                GROUP BY target_presence
                """,
                (
                    experiment_id,
                ),
            ).fetchall()

        target_presence = {
            row["target_presence"]:
                row["count"]
            for row in target_rows
        }

        # ====================================================
        # DISTANCES
        # ====================================================

        if experiment_id is None:

            distance_rows = connection.execute(
                """
                SELECT
                    CASE
                        WHEN distance_cm IS NULL
                            THEN 'Unknown'

                        ELSE CAST(
                            distance_cm AS TEXT
                        )
                    END AS distance,

                    COUNT(*) AS count

                FROM samples

                GROUP BY
                    CASE
                        WHEN distance_cm IS NULL
                            THEN 'Unknown'

                        ELSE CAST(
                            distance_cm AS TEXT
                        )
                    END

                ORDER BY distance
                """
            ).fetchall()

        else:

            distance_rows = connection.execute(
                """
                SELECT
                    CASE
                        WHEN distance_cm IS NULL
                            THEN 'Unknown'

                        ELSE CAST(
                            distance_cm AS TEXT
                        )
                    END AS distance,

                    COUNT(*) AS count

                FROM samples

                WHERE experiment_id = ?

                GROUP BY
                    CASE
                        WHEN distance_cm IS NULL
                            THEN 'Unknown'

                        ELSE CAST(
                            distance_cm AS TEXT
                        )
                    END

                ORDER BY distance
                """,
                (
                    experiment_id,
                ),
            ).fetchall()

        distances = {
            row["distance"]:
                row["count"]
            for row in distance_rows
        }

        # ====================================================
        # FINAL SUMMARY
        # ====================================================

        return {
            "total_samples":
                total_samples,

            "labeled_samples":
                labeled_samples,

            "evaluable_predictions":
                evaluable_predictions,

            "correct_predictions":
                correct_predictions,

            "incorrect_predictions":
                incorrect_predictions,

            "accuracy":
                accuracy,

            "positions":
                positions,

            "target_presence":
                target_presence,

            "distances":
                distances,
        }

    finally:
        connection.close()