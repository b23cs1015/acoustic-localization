def save_prediction(
    sample_id: int,
    predicted_position_id: Optional[int],
    confidence: Optional[float],
    evaluation: str,
):
    """
    Save prediction results.

    The predicted position must belong to the same experiment
    as the sample.
    """

    connection = get_connection()

    try:

        sample = connection.execute(
            """
            SELECT
                id,
                experiment_id
            FROM samples
            WHERE id = ?
            """,
            (
                sample_id,
            ),
        ).fetchone()

        if sample is None:
            return None

        experiment_id = sample[
            "experiment_id"
        ]

        # ----------------------------------------------------
        # Validate predicted position.
        # ----------------------------------------------------

        if predicted_position_id is not None:

            position = connection.execute(
                """
                SELECT id
                FROM positions
                WHERE id = ?
                  AND experiment_id = ?
                """,
                (
                    predicted_position_id,
                    experiment_id,
                ),
            ).fetchone()

            if position is None:

                raise ValueError(
                    "Predicted position does not belong "
                    "to the sample's experiment."
                )

        prediction_timestamp = datetime.now(
            timezone.utc
        ).isoformat()

        connection.execute(
            """
            UPDATE samples
            SET
                predicted_position_id = ?,

                prediction_confidence = ?,

                prediction_evaluation = ?,

                prediction_timestamp = ?

            WHERE id = ?
            """,
            (
                predicted_position_id,
                confidence,
                evaluation,
                prediction_timestamp,
                sample_id,
            ),
        )

        connection.commit()

        return get_sample(
            sample_id,
            experiment_id=experiment_id,
        )

    finally:
        connection.close()


# ============================================================
# UPDATE PREDICTION
# ============================================================

def update_sample_prediction(
    sample_id: int,
    predicted_position_id: Optional[int],
    prediction_confidence: Optional[float],
    prediction_evaluation: Optional[str] = None,
    experiment_id: Optional[int] = None,
):
    """
    Store prediction information for a sample.

    If experiment_id is supplied:

        sample must belong to that experiment

        predicted position must belong to that experiment
    """

    conn = get_connection()

    try:

        # ----------------------------------------------------
        # Validate sample.
        # ----------------------------------------------------

        if experiment_id is None:

            sample = conn.execute(
                """
                SELECT
                    id,
                    experiment_id
                FROM samples
                WHERE id = ?
                """,
                (
                    sample_id,
                ),
            ).fetchone()

        else:

            sample = conn.execute(
                """
                SELECT
                    id,
                    experiment_id
                FROM samples
                WHERE id = ?
                  AND experiment_id = ?
                """,
                (
                    sample_id,
                    experiment_id,
                ),
            ).fetchone()

        if sample is None:

            raise ValueError(
                f"Sample {sample_id} does not exist "
                f"for the selected experiment."
            )

        actual_experiment_id = sample[
            "experiment_id"
        ]

        # ----------------------------------------------------
        # Validate predicted position.
        # ----------------------------------------------------

        if predicted_position_id is not None:

            position = conn.execute(
                """
                SELECT id
                FROM positions
                WHERE id = ?
                  AND experiment_id = ?
                """,
                (
                    predicted_position_id,
                    actual_experiment_id,
                ),
            ).fetchone()

            if position is None:

                raise ValueError(
                    "Predicted position does not belong "
                    "to the sample's experiment."
                )

        # ----------------------------------------------------
        # Timestamp.
        # ----------------------------------------------------

        prediction_timestamp = datetime.now(
            timezone.utc
        ).isoformat()

        # ----------------------------------------------------
        # Save prediction.
        # ----------------------------------------------------

        conn.execute(
            """
            UPDATE samples
            SET
                predicted_position_id = ?,

                prediction_confidence = ?,

                prediction_evaluation = ?,

                prediction_timestamp = ?

            WHERE id = ?
            """,
            (
                predicted_position_id,
                prediction_confidence,
                prediction_evaluation,
                prediction_timestamp,
                sample_id,
            ),
        )

        conn.commit()

        return get_sample(
            sample_id,
            experiment_id=actual_experiment_id,
        )

    finally:
        conn.close()


