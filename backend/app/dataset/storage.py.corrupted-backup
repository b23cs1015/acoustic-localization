def create_sample(
    recording_filename: Optional[str] = None,
    position_id: Optional[int] = None,
    target_presence: Optional[str] = None,
    distance_cm: Optional[float] = None,
    remarks: Optional[str] = None,
    features: Optional[dict] = None,
    duration_seconds: Optional[float] = None,
    sample_rate: Optional[int] = None,
    experiment_id: int = 1,
):
    """
    Create a sample inside an experiment.

    IMPORTANT:

    position_id must belong to the selected experiment.

    This prevents samples from EXP-002 accidentally using
    positions belonging to EXP-001.

    Sample codes use the existing AL-XXXX convention.
    Existing samples retain their original codes.
    New samples receive the next available AL-XXXX code.
    """

    ensure_experiment_exists(
        experiment_id
    )

    conn = get_connection()

    try:

        # ----------------------------------------------------
        # Verify position belongs to experiment.
        # ----------------------------------------------------

        if position_id is not None:

            position = conn.execute(
                """
                SELECT id
                FROM positions
                WHERE id = ?
                  AND experiment_id = ?
                """,
                (
                    position_id,
                    experiment_id,
                ),
            ).fetchone()

            if position is None:

                raise ValueError(
                    f"Position {position_id} does not belong "
                    f"to experiment {experiment_id}."
                )

        # ----------------------------------------------------
        # Timestamp
        # ----------------------------------------------------

        timestamp = datetime.now(
            timezone.utc
        ).isoformat()

        # ----------------------------------------------------
        # Serialize features.
        # ----------------------------------------------------

        features_json = None

        if features is not None:

            features_json = json.dumps(
                features
            )

        # ----------------------------------------------------
        # Generate sample code BEFORE INSERT.
        #
        # The samples table requires sample_code to be
        # non-null, so it must be supplied during INSERT.
        # ----------------------------------------------------

        next_id_row = conn.execute(
            """
            SELECT COALESCE(
                MAX(id),
                0
            ) + 1 AS next_id
            FROM samples
            """
        ).fetchone()

        next_sample_id = int(
            next_id_row["next_id"]
        )

        sample_code = _generate_sample_code(
            next_sample_id
        )

        # ----------------------------------------------------
        # Insert sample.
        # ----------------------------------------------------

        cursor = conn.execute(
            """
            INSERT INTO samples (
                sample_code,
                timestamp,
                recording_filename,
                position_id,
                target_presence,
                distance_cm,
                remarks,
                features,
                duration_seconds,
                sample_rate,
                experiment_id
            )
            VALUES (
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?
            )
            """,
            (
                sample_code,
                timestamp,
                recording_filename,
                position_id,
                target_presence,
                distance_cm,
                remarks,
                features_json,
                duration_seconds,
                sample_rate,
                experiment_id,
            ),
        )

        sample_id = cursor.lastrowid

        conn.commit()

        return get_sample(
            sample_id,
            experiment_id=experiment_id,
        )

    finally:
        conn.close()
