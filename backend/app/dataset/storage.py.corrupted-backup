def create_position(
    name: str,
    experiment_id: int = 1,
):
    """
    Create a position inside an experiment.

    Position numbering is scoped to the experiment.

    Example:

        EXP-001:
            Pos 1
            Pos 2
            Pos 3

        EXP-002:
            Pos 1
            Pos 2
            Pos 3

    Position IDs remain globally unique, while position
    numbers are experiment-specific.
    """

    ensure_experiment_exists(
        experiment_id
    )

    name = name.strip()

    if not name:

        raise ValueError(
            "Position name cannot be empty."
        )

    conn = get_connection()

    try:

        # ----------------------------------------------------
        # Check duplicate position name.
        # ----------------------------------------------------

        existing = conn.execute(
            """
            SELECT
                id,
                experiment_id,
                position_number,
                name,
                created_at
            FROM positions
            WHERE experiment_id = ?
              AND name = ?
            """,
            (
                experiment_id,
                name,
            ),
        ).fetchone()

        if existing:

            raise ValueError(
                f"Position '{name}' already exists "
                f"in experiment {experiment_id}."
            )

        # ----------------------------------------------------
        # Get next position number.
        # ----------------------------------------------------

        row = conn.execute(
            """
            SELECT
                COALESCE(
                    MAX(position_number),
                    0
                ) + 1 AS next_number
            FROM positions
            WHERE experiment_id = ?
            """,
            (
                experiment_id,
            ),
        ).fetchone()

        position_number = row[
            "next_number"
        ]

        created_at = datetime.now(
            timezone.utc
        ).isoformat()

        cursor = conn.execute(
            """
            INSERT INTO positions (
                experiment_id,
                position_number,
                name,
                created_at
            )
            VALUES (?, ?, ?, ?)
            """,
            (
                experiment_id,
                position_number,
                name,
                created_at,
            ),
        )

        conn.commit()

        position_id = cursor.lastrowid

        result = conn.execute(
            """
            SELECT
                id,
                experiment_id,
                position_number,
                name,
                created_at
            FROM positions
            WHERE id = ?
            """,
            (
                position_id,
            ),
        ).fetchone()

        return dict(result)

    finally:
        conn.close()


