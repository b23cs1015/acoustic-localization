# ============================================================
# SAMPLE RETRIEVAL
# ============================================================

def get_sample(
    sample_id: int,
    experiment_id: Optional[int] = None,
):
    """
    Return one sample.

    Position names are included in the returned object.

    This makes frontend/API responses easier to use without
    breaking the original numeric position IDs.
    """

    conn = get_connection()

    try:

        if experiment_id is None:

            row = conn.execute(
                """
                SELECT
                    s.*,

                    p.name AS position_name,

                    pp.name AS predicted_position_name

                FROM samples s

                LEFT JOIN positions p
                    ON s.position_id = p.id

                LEFT JOIN positions pp
                    ON s.predicted_position_id = pp.id

                WHERE s.id = ?
                """,
                (
                    sample_id,
                ),
            ).fetchone()

        else:

            row = conn.execute(
                """
                SELECT
                    s.*,

                    p.name AS position_name,

                    pp.name AS predicted_position_name

                FROM samples s

                LEFT JOIN positions p
                    ON s.position_id = p.id

                LEFT JOIN positions pp
                    ON s.predicted_position_id = pp.id

                WHERE s.id = ?
                  AND s.experiment_id = ?
                """,
                (
                    sample_id,
                    experiment_id,
                ),
            ).fetchone()

        if row is None:
            return None

        result = dict(row)

        # ----------------------------------------------------
        # Decode JSON features.
        # ----------------------------------------------------

        if result.get("features"):

            try:

                result["features"] = json.loads(
                    result["features"]
                )

            except json.JSONDecodeError:
                pass

        return result

    finally:
        conn.close()


