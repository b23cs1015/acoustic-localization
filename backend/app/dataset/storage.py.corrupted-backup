def get_experiment_directory(
    experiment_id: int,
) -> Path:
    """
    Return the filesystem directory for one experiment.

    Example:

        EXP-001
        EXP-002
        EXP-003
    """

    experiment_dir = (
        EXPERIMENTS_DIR
        / f"EXP-{experiment_id:03d}"
    )

    experiment_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    return experiment_dir


def get_experiment_recordings_dir(
    experiment_id: int,
) -> Path:
    """
    Return the recordings directory for one experiment.
    """

    recordings_dir = (
        get_experiment_directory(
            experiment_id
        )
        / "recordings"
    )

    recordings_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    return recordings_dir


# ============================================================
# DATABASE INITIALIZATION
# ============================================================

def initialize_dataset_database():
    """
    Initialize the dataset database.

    This function is intentionally compatible with the
    original dataset system.

    Experiment-specific migration/schema changes are handled
    by dataset.experiments.initialize_experiment_database().
    """

    DATASET_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    conn = get_connection()

    try:

        # ----------------------------------------------------
        # Legacy/base positions table.
        #
        # The experiment migration later adds experiment_id
        # and adjusts the uniqueness rules.
        # ----------------------------------------------------

        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS positions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,

                position_number INTEGER NOT NULL,

                name TEXT NOT NULL,

                created_at TEXT NOT NULL
            )
            """
        )

        # ----------------------------------------------------
        # Base samples table.
        #
        # experiment_id is included here so a new database
        # immediately supports the experiment architecture.
        #
        # Existing databases are upgraded separately by the
        # experiment migration.
        # ----------------------------------------------------

        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS samples (
                id INTEGER PRIMARY KEY AUTOINCREMENT,

                sample_code TEXT UNIQUE,

                timestamp TEXT NOT NULL,

                recording_filename TEXT,

                position_id INTEGER,

                target_presence TEXT,

                distance_cm REAL,

                remarks TEXT,

                features TEXT,

                duration_seconds REAL,

                sample_rate INTEGER,

                predicted_position_id INTEGER,

                prediction_confidence REAL,

                prediction_evaluation TEXT,

                prediction_timestamp TEXT,

                experiment_id INTEGER,

                FOREIGN KEY(position_id)
                    REFERENCES positions(id),

                FOREIGN KEY(predicted_position_id)
                    REFERENCES positions(id)
            )
            """
        )

        conn.commit()

    finally:
        conn.close()


