def get_positions(
    experiment_id: Optional[int] = None,
):
    """
    Return positions.

    If experiment_id is provided:
        return only positions from that experiment.

    If experiment_id is omitted:
        return all positions.

    The latter behaviour preserves compatibility with the
    original dataset API.
    """

    conn = get_connection()

    try:

        if experiment_id is None:

            rows = conn.execute(
                """
                SELECT
                    id,
                    experiment_id,
                    position_number,
                    name,
                    created_at
                FROM positions
                ORDER BY
                    experiment_id,
                    position_number
                """
            ).fetchall()

        else:

            rows = conn.execute(
                """
                SELECT
                    id,
                    experiment_id,
                    position_number,
                    name,
                    created_at
                FROM positions
                WHERE experiment_id = ?
                ORDER BY position_number
                """,
                (
                    experiment_id,
                ),
            ).fetchall()

        return [
            dict(row)
            for row in rows
        ]

    finally:
        conn.close()


